        //         "reasoningEffort": "max"
        //       },
        //       "thinking_config": {
        //         "reasoning_effort": "max",
        //         "thinkingBudget": 32768,
        //         "reasoningEffort": "max"
        //       },
        //     },
        //     "high": {
        //       "thinkingConfig": {
        //         "reasoning_effort": "high",
        //         "thinking_budget": 16164,
        //         "reasoningEffort": "high"
        //       },
        //       "thinking_config": {
        //         "reasoning_effort": "high",
        //         "thinking_budget": 16164,
        //         "reasoningEffort": "high"
        //       },
        //     }
        //   }
        // }
      }
    },
    "opencode-go-modified": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Opencode Go Modified",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
      },
      "models": {
        "hy3": {
          "name": "Hy3 198k",
          "limit": {
            "context": 198000,
            "output": 64000,
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "frequency_penalty": 0.4,
            "reasoningEffort": "high",
            "reasoning_effort": "high",
          },
          "variants": {
            "high": {
              "thinking_config": {
                "frequency_penalty": 0.4,
                "reasoning_effort": "high",
                "thinkingBudget": 32768,
                "reasoningEffort": "high"
              },
              "thinkingConfig": {
                "frequency_penalty": 0.4,
                "reasoning_effort": "high",
                "thinkingBudget": 32768,
                "reasoningEffort": "high"
              },
            }
          }
        },
        "mimo-v2.5": {
          "name": "MiMo-V2.5 366k",
          "limit": {
            "context": 366144,
            "output": 366144,
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "frequency_penalty": 0.4,
            "reasoningEffort": "high",
            "reasoning_effort": "high",
          },
          "variants": {
            "high": {
              "thinking_config": {
                "frequency_penalty": 0.4,
                "reasoning_effort": "high",
                "thinkingBudget": 32768,
                "reasoningEffort": "high"
              },
              "thinkingConfig": {
                "frequency_penalty": 0.4,
                "reasoning_effort": "high",
                "thinkingBudget": 32768,
                "reasoningEffort": "high"
              },
            }
          }
        },
        // "deepseek-v4-flash": {
        //   "name": "deepseek-v4-flash 366k",
        //   "limit": {
        //     "context": 366144,
        //     "output": 366144
        //   },
        //   "options": {
        //     "reasoningEffort": "max",
        //     "reasoning_effort": "max",
        //   },
        //   "variants": {
        //     "max": {
        //       "thinkingConfig": {
        //         "reasoning_effort": "max",
        //         "thinkingBudget": 32768,
        //         "reasoningEffort": "max"
        //       },
        //       "thinking_config": {
        //         "reasoning_effort": "max",
        //         "thinkingBudget": 32768,
        //         "reasoningEffort": "max"
        //       },
        //     },
        //     "high": {
        //       "thinkingConfig": {
        //         "reasoning_effort": "high",
        //         "thinking_budget": 16164,
        //         "reasoningEffort": "high"
        //       },
        //       "thinking_config": {
        //         "reasoning_effort": "high",
        //         "thinking_budget": 16164,
        //         "reasoningEffort": "high"
        //       },
        //     }
        //   }
        // }
      }
    },
    "openference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Openference",
      "options": {
        "baseURL": "https://api.openference.com/v1",
      },
      "models": {
        "GLM-5.2": {
          "name": "GLM-5.2 (via Openference)"
        }
      }
    }
  },
  "lsp": {
    "just": {
      "command": [
        "just-lsp"
      ],
      "extensions": [
        "Justfile",
        "justfile"
      ]
    },
    "rust": {
      "disabled": true,
    },
    "rust-analyzer": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ],
      "initialization": {
        "checkOnSave": {
          "enable": false
        }
      }
    },
    // "kotlin-lsp": {
    //   "command": [
    //     "kotlin-lsp",
    //     "--stdio"
    //   ],
    //   "extensions": [
    //     ".kt",
    //     ".kts"
    //   ]
    // }
  },
  "mcp": {
    "maestro": {
      "type": "local",
      "command": [
        "maestro",
        "mcp"
      ],
      "enabled": false
    }
  },
  "formatter": {
    "ktfmt": {
      "command": [
        "ktfmt",
        "--kotlinlang-style",
        "$FILE"
      ],
      "extensions": [
        ".kt",
        ".kts"
      ]
    }
  }
}
